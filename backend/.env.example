POSTGRESQL_USER=lab3
POSTGRESQL_PASSWORD=change_me
POSTGRESQL_DATABASE=lab3
POSTGRESQL_JNDI=java:jboss/datasources/Lab3DataSource

# В Docker Compose переопределяется на jdbc:postgresql://db:5432/lab3
POSTGRESQL_URL=jdbc:postgresql://localhost:5433/lab3

# Случайный секрет: 32 байта в Base64URL
JWT_SECRET_BASE64URL=

# Для локального запуска:   file:/абсолютный/путь/к/jwt-secret.jwk
JWT_SECRET_KEY_LOCATION=